        <record id="seq_travel_sale_order" model="ir.sequence">
            <field name="name">Travel Sale Order</field>
            <field name="code">travel.sale.order</field>
            <field name="padding">0</field>
            <field name="use_date_range" eval="True"/>
        </record>
        <!-- Per-type SO sequences, reset each Indian FY -->
        <record id="seq_so_car" model="ir.sequence">
            <field name="name">Car SO Sequence</field>
            <field name="code">travel.so.car</field>
            <field name="padding">0</field>
