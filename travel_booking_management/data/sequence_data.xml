<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hotel_booking" model="ir.sequence">
            <field name="name">Hotel Booking</field>
            <field name="code">travel.hotel.booking</field>
            <field name="prefix">HTL/%(year)s/</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_domestic_flight_booking" model="ir.sequence">
            <field name="name">Domestic Flight Booking</field>
