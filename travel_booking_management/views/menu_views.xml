<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Client Action -->
    <record id="action_the_earth_dashboard" model="ir.actions.client">
        <field name="name">The Earth Dashboard</field>
        <field name="tag">travel_booking_management.dashboard</field>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_travel_booking_root" name="The Earth" sequence="50"
              web_icon="travel_booking_management,static/description/icon.png"
              action="action_the_earth_dashboard"/>

    <!-- Dashboard -->
    <menuitem id="menu_dashboard" name="Dashboard" parent="menu_travel_booking_root" sequence="1"
              action="action_the_earth_dashboard"/>

    <!-- New Booking Parent -->
    <menuitem id="menu_bookings" name="New Booking" parent="menu_travel_booking_root" sequence="10"/>

    <menuitem id="menu_hotel_booking" name="Hotel" parent="menu_bookings" sequence="10"
              action="action_hotel_booking"/>
    <menuitem id="menu_domestic_flight_booking" name="Domestic Flight" parent="menu_bookings" sequence="20"
              action="action_domestic_flight_booking"/>
    <menuitem id="menu_intl_flight_booking" name="International Flight" parent="menu_bookings" sequence="30"
              action="action_intl_flight_booking"/>
    <menuitem id="menu_train_booking" name="Train" parent="menu_bookings" sequence="40"
              action="action_train_booking"/>
    <menuitem id="menu_bus_booking" name="Bus" parent="menu_bookings" sequence="50"
              action="action_bus_booking"/>
    <menuitem id="menu_car_booking" name="Car" parent="menu_bookings" sequence="60"
              action="action_car_booking"/>
    <menuitem id="menu_insurance_booking" name="Insurance" parent="menu_bookings" sequence="70"
              action="action_insurance_booking"/>
    <menuitem id="menu_visa_booking" name="Visa" parent="menu_bookings" sequence="80"
              action="action_visa_booking"/>
    <menuitem id="menu_package_tour_booking" name="Package Tours" parent="menu_bookings" sequence="90"
              action="action_package_tour_booking"/>
    <menuitem id="menu_event_booking" name="Event" parent="menu_bookings" sequence="100"
              action="action_event_booking"/>

    <!-- Cancellations Parent -->
    <menuitem id="menu_cancellations" name="Cancellations" parent="menu_travel_booking_root" sequence="20"/>

    <menuitem id="menu_cancellation_old" name="General Cancellations" parent="menu_cancellations" sequence="10"
              action="action_cancellation"/>
    <menuitem id="menu_hotel_cancellation" name="Hotel" parent="menu_cancellations" sequence="15"
              action="action_hotel_cancellation"/>
    <menuitem id="menu_bus_cancellation" name="Bus" parent="menu_cancellations" sequence="20"
              action="action_bus_cancellation"/>
    <menuitem id="menu_domestic_flight_cancellation" name="Domestic Flight" parent="menu_cancellations" sequence="30"
              action="action_domestic_flight_cancellation"/>
    <menuitem id="menu_intl_flight_cancellation" name="International Flight" parent="menu_cancellations" sequence="40"
              action="action_intl_flight_cancellation"/>
    <menuitem id="menu_train_cancellation" name="Train" parent="menu_cancellations" sequence="50"
              action="action_train_cancellation"/>
    <menuitem id="menu_insurance_cancellation" name="Insurance" parent="menu_cancellations" sequence="60"
              action="action_insurance_cancellation"/>
    <menuitem id="menu_visa_cancellation" name="Visa" parent="menu_cancellations" sequence="70"
              action="action_visa_cancellation"/>

    <!-- Reports / Export -->
    <menuitem id="menu_reports" name="Reports" parent="menu_travel_booking_root" sequence="30"/>

    <!-- Booking Exports -->
    <menuitem id="menu_hotel_export" name="Export Hotel Bookings" parent="menu_reports" sequence="10"
              action="action_hotel_booking_export"/>
    <menuitem id="menu_bus_export" name="Export Bus Bookings" parent="menu_reports" sequence="20"
              action="action_bus_booking_export"/>
    <menuitem id="menu_train_export" name="Export Train Bookings" parent="menu_reports" sequence="30"
              action="action_train_booking_export"/>
    <menuitem id="menu_domestic_flight_export" name="Export Domestic Flight Bookings" parent="menu_reports" sequence="40"
              action="action_domestic_flight_export"/>
    <menuitem id="menu_intl_flight_export" name="Export Intl Flight Bookings" parent="menu_reports" sequence="50"
              action="action_intl_flight_export"/>
    <menuitem id="menu_car_export" name="Export Car Bookings" parent="menu_reports" sequence="60"
              action="action_car_booking_export"/>
    <menuitem id="menu_insurance_export" name="Export Insurance Bookings" parent="menu_reports" sequence="70"
              action="action_insurance_booking_export"/>
    <menuitem id="menu_visa_export" name="Export Visa Bookings" parent="menu_reports" sequence="80"
              action="action_visa_booking_export"/>
    <menuitem id="menu_package_tour_export" name="Export Package Tour Bookings" parent="menu_reports" sequence="90"
              action="action_package_tour_export"/>
    <menuitem id="menu_event_export" name="Export Event Bookings" parent="menu_reports" sequence="100"
              action="action_event_booking_export"/>

    <!-- Cancellation Exports -->
    <menuitem id="menu_hotel_cancel_export" name="Export Hotel Cancellations" parent="menu_reports" sequence="110"
              action="action_hotel_cancellation_export"/>
    <menuitem id="menu_bus_cancel_export" name="Export Bus Cancellations" parent="menu_reports" sequence="120"
              action="action_bus_cancellation_export"/>
    <menuitem id="menu_train_cancel_export" name="Export Train Cancellations" parent="menu_reports" sequence="130"
              action="action_train_cancellation_export"/>
    <menuitem id="menu_dom_flight_cancel_export" name="Export Dom. Flight Cancellations" parent="menu_reports" sequence="140"
              action="action_dom_flight_cancel_export"/>
    <menuitem id="menu_intl_flight_cancel_export" name="Export Intl Flight Cancellations" parent="menu_reports" sequence="150"
              action="action_intl_flight_cancel_export"/>
    <menuitem id="menu_insurance_cancel_export" name="Export Insurance Cancellations" parent="menu_reports" sequence="160"
              action="action_insurance_cancel_export"/>
    <menuitem id="menu_visa_cancel_export" name="Export Visa Cancellations" parent="menu_reports" sequence="170"
              action="action_visa_cancel_export"/>

    <!-- Configuration -->
    <menuitem id="menu_configuration" name="Configuration" parent="menu_travel_booking_root" sequence="40"/>
    <menuitem id="menu_service_charges" name="Service Charges" parent="menu_configuration" sequence="10"
              action="action_service_charge"/>

    <!-- Invoicing -->
    <menuitem id="menu_invoicing" name="Invoicing" parent="menu_travel_booking_root" sequence="25"/>
    <menuitem id="menu_generate_service_invoice" name="Generate Service Invoice"
              parent="menu_invoicing" sequence="10"
              action="action_service_invoice_wizard"/>
    <menuitem id="menu_generate_debit_note" name="Generate Debit Note"
              parent="menu_invoicing" sequence="20"
              action="action_debit_note_wizard"/>
    <menuitem id="menu_generate_credit_note" name="Generate Credit Note"
              parent="menu_invoicing" sequence="30"
              action="action_credit_note_wizard"/>
</odoo>
