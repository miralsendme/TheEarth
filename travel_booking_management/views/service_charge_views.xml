<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_charge_form" model="ir.ui.view">
        <field name="name">travel.service.charge.form</field>
        <field name="model">travel.service.charge</field>
        <field name="arch" type="xml">
            <form string="Service Charge">
                <sheet>
                    <group>
                        <group string="Charge Setup">
                            <field name="booking_type"/>
                            <field name="charge_type"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="charge_type == 'percentage'"/>
                            <field name="active"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_service_charge_list" model="ir.ui.view">
        <field name="name">travel.service.charge.list</field>
        <field name="model">travel.service.charge</field>
        <field name="arch" type="xml">
            <list string="Service Charges" editable="bottom">
                <field name="booking_type"/>
                <field name="charge_type"/>
                <field name="amount"/>
                <field name="currency_id" optional="show"/>
                <field name="active"/>
                <field name="notes" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_service_charge" model="ir.actions.act_window">
        <field name="name">Service Charges</field>
        <field name="res_model">travel.service.charge</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define service charges for each booking type
            </p>
            <p>Set fixed amounts or percentage-based charges that will auto-fill on bookings and cancellations.</p>
        </field>
    </record>
</odoo>
