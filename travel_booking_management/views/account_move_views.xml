<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_travel" model="ir.ui.view">
        <field name="name">account.move.form.inherit.travel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="is_travel_service_invoice" invisible="1"/>
                <field name="is_travel_debit_note" invisible="1"/>
                <field name="is_travel_credit_note" invisible="1"/>
                <button name="action_print_tax_invoice" type="object"
                        string="Print Tax Invoice" class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not is_travel_service_invoice"/>
                <button name="action_print_debit_note" type="object"
                        string="Print Debit Note" class="oe_stat_button"
                        icon="fa-print"
                        invisible="not is_travel_debit_note"/>
                <button name="action_print_credit_note" type="object"
                        string="Print Credit Note" class="oe_stat_button"
                        icon="fa-print"
                        invisible="not is_travel_credit_note"/>
            </xpath>
        </field>
    </record>
</odoo>
