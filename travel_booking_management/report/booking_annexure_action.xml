<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report actions for each booking model - used to generate annexure PDFs -->

    <record id="action_report_annexure_domestic_flight" model="ir.actions.report">
        <field name="name">Booking Annexure</field>
        <field name="model">travel.domestic.flight.booking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">travel_booking_management.report_booking_annexure_document</field>
        <field name="report_file">travel_booking_management.report_booking_annexure_document</field>
        <field name="print_report_name">'Annexure_%s' % object.name</field>
        <field name="binding_model_id" ref="model_travel_domestic_flight_booking"/>
        <field name="binding_type">report</field>
    </record>

